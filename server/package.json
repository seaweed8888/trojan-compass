{
  "name": "@trojan-compass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "validate:data": "tsx --env-file-if-exists=.env src/validate-data.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@trojan-compass/shared": "0.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "openai": "^7.57.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.20.6"
  }
}
